rules_version = '3';
service cloud.firestore {
  match /databases/{database}/documents {
    // USER DEFAULTS
    // Only the authenticated user can read/write their own default configs
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // CUSTOM SCENARIOS
    // Only the authenticated teacher can read, create, update or delete their own scenarios
    match /scenarios/{scenarioId} {
      // Allows read if the scenario belongs to the user
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.teacherUid;
      // Allows creation only if the user is assigning their own uid
      allow create: if request.auth != null && request.auth.uid == request.resource.data.teacherUid;
    }
  }
}
